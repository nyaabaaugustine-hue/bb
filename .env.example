# Copy to .env.local. Keep the actual file out of Git.
# Neon CLI populates the database and Auth URLs after `neon deploy`.
DATABASE_URL=
DATABASE_URL_UNPOOLED=
NEON_BRANCH=
NEON_AUTH_BASE_URL=
NEON_AUTH_JWKS_URL=

# Public site settings (safe to expose to the browser).
# Canonical origin used by metadata, sitemap.xml and robots.txt.
NEXT_PUBLIC_SITE_URL=
# Business Gmail address used by every email button.
NEXT_PUBLIC_EMAIL=
# B B Homes company LinkedIn page used by the team "Connect on LinkedIn" buttons.
NEXT_PUBLIC_LINKEDIN_URL=
# Cloudinary cloud name that hosts listing photos and the logo.
NEXT_PUBLIC_CLOUDINARY_CLOUD=

# Required by the Next.js server SDK. Generate a unique value of at least 32 characters.
NEON_AUTH_COOKIE_SECRET=

# Comma-separated verified administrator bootstrap accounts (highest access level).
SUPER_ADMIN_EMAILS=

# Formspree inbox that every website enquiry and newsletter sign-up is mirrored to.
# Optional: the live endpoint is the built-in default.
FORMSPREE_ENDPOINT=https://formspree.io/f/xwllnqla

# Optional test-user seeder. Use only a non-production Neon branch.
TEST_USERS_ENABLED=false
TEST_USERS_TARGET=
TEST_USERS_CONFIRM_BRANCH=
TEST_ADMIN_EMAIL=
TEST_ADMIN_PASSWORD=
TEST_STAFF_EMAIL=
TEST_STAFF_PASSWORD=
TEST_CUSTOMER_EMAIL=
TEST_CUSTOMER_PASSWORD=
